# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables & secrets (CRITICAL FOR SECURITY)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
ai-service/.env
ai-service/.env.*
!ai-service/.env.example

# Python Virtual Environments, Cache & Model Weights
venv/
.venv/
ai-service/venv/
ai-service/.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Build & Output directories
dist/
build/
frontend/dist/
frontend/build/

# Uploads, results & temporary files (Keep directories clean)
backend/uploads/*
!backend/uploads/.gitkeep
backend/results/*
!backend/results/.gitkeep
backend/temp_uploads/*
!backend/temp_uploads/.gitkeep
ai-service/uploads/*
!ai-service/uploads/.gitkeep
ai-service/results/*
!ai-service/results/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE specific files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user
